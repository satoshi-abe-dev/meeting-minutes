.DS_Store

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# pytest
.pytest_cache/

# venv / packaging
.venv/
venv/
*.egg-info/

# 生成物（動画名ごとの文字起こし・フレーム・議事録）。実行時データなのでコミットしない。
# ディレクトリ自体は .gitkeep で残す（`output/` だと親ごと除外され .gitkeep を再包含できない）。
output/*
!output/.gitkeep

# ローカルにダウンロードした Whisper / LLM モデルの置き場（使う場合）
models/

# 個人設定（config.example.toml をコピーして作る）
config.toml

# Claude Code の作業用フォルダー。原則コミットしない（権限設定・skill・実運用の
# セッションログ ai-workflow/ 等は非公開のまま）。ただし運用ルール .claude/CLAUDE.md
# だけは機密性が無く「AI協調開発」の一次資料として公開する（Issue #61）。
# .claude/* は直下だけにマッチするので ai-workflow/ 等サブディレクトリの中身は除外が続く。
.claude/*
!.claude/CLAUDE.md

# 非公開ファイル専用フォルダー（面接想定問答集などの個人資料）。まるごとコミットしない
# （Issue #65）。Claude Code が自動読み込みする .claude/CLAUDE.md だけはここへ移せず
# .claude/ 側に残る。
private/

# Claude Code に見せる画像・動画などの一時受け渡し場所
temp/

# 旧パスのセッションログ（Issue #59 で .claude/ai-workflow/ へ移動済み）。この移行を
# pull する前のチェックアウトや別マシンに旧パスの未追跡ファイルが残っている場合に、
# それが誤って追跡対象へ入らないよう保護だけ残す。
doc/ai-workflow/SESSION_LOG.md
docs/ai-workflow/SESSION_LOG.md

# 実運用中のカスタム議事録テンプレート（利用者ごとの様式。機密になり得るのでコミット
# しない）。雛形の templates/minutes_template_example.txt は追跡対象のまま。
templates/minutes_template.txt

# 旧パスの面接想定問答集（Issue #65 で private/ へ移動済み）。private/ の丸ごと ignore は
# 新しい場所しか守らないので、この移行を pull する前のチェックアウトや別マシンに旧パスの
# 未追跡ファイルが残っている場合に、それが誤って追跡対象へ入らないよう保護だけ残す。
docs/interview-qa.md

